{
  "schema_version": 2,
  "kind": "caption",
  "scripts": ["deva", "latn"],
  "meta": {
    "id": "hindi_creator",
    "name": "Hindi Creator - Bold Box",
    "version": 1,
    "author": "starter",
    "license": "Template: MIT. Fonts: SIL OFL 1.1",
    "tags": ["hindi", "hinglish", "creator", "shorts"]
  },
  "aspects": ["9:16", "1:1", "4:5"],
  "fonts": {
    "latn": {
      "family": "Poppins",
      "weight": 700,
      "fallback": ["Noto Sans", "DejaVu Sans", "Sans"]
    },
    "deva": {
      "family": "Mukta",
      "weight": 800,
      "fallback": ["Noto Sans Devanagari", "DejaVu Sans", "Sans"]
    },
    "beng": {
      "family": "Noto Sans Bengali",
      "weight": 700,
      "fallback": ["Hind Siliguri", "DejaVu Sans", "Sans"]
    }
  },
  "text": {
    "size_px": 72,
    "case": "upper",
    "letter_spacing_px": 0,
    "line_height": 1.18
  },
  "colors": {
    "primary": "#FFFFFF",
    "active": "#FFE600",
    "outline": "#000000",
    "shadow": "#000000CC",
    "box": "#000000CC"
  },
  "stroke": {
    "outline_px": 5,
    "shadow_px": 2,
    "shadow_offset": [2, 2]
  },
  "box": {
    "enabled": true,
    "padding_px": 16,
    "radius_px": 12,
    "opacity": 0.85
  },
  "layout": {
    "anchor": "bottom_center",
    "y_percent": 68,
    "align": "center",
    "max_words_per_line": 3,
    "max_lines": 2,
    "max_chars": {
      "latn": 22,
      "deva": 18,
      "beng": 18
    },
    "safe_area_profile": "shorts_default"
  },
  "animation": {
    "mode": "pages",
    "active_word": "highlight",
    "in": "pop",
    "out": "none",
    "duration_ms": 150,
    "easing": "ease_out"
  },
  "emphasis": {
    "keywords_bold": true,
    "keyword_color": "#38BDF8",
    "numbers_color": "#FFE600"
  },
  "emoji": {
    "enabled": false
  },
  "speaker_colors": {
    "enabled": false,
    "palette": []
  }
}
