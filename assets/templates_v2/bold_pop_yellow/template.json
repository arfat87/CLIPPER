{
  "schema_version": 2,
  "meta": {
    "id": "bold_pop_yellow",
    "name": "Bold Pop - Yellow",
    "version": 1,
    "author": "starter",
    "license": "Template: MIT. Fonts: SIL OFL 1.1 (verify files at install)",
    "tags": [
      "bold",
      "pop",
      "shorts"
    ]
  },
  "aspects": [
    "9:16",
    "1:1",
    "4:5"
  ],
  "fonts": {
    "latn": {
      "family": "Montserrat",
      "weight": 800,
      "fallback": [
        "Noto Sans"
      ]
    },
    "deva": {
      "family": "Mukta",
      "weight": 800,
      "fallback": [
        "Noto Sans Devanagari"
      ]
    },
    "beng": {
      "family": "Hind Siliguri",
      "weight": 700,
      "fallback": [
        "Noto Sans Bengali"
      ]
    }
  },
  "text": {
    "size_px": 78,
    "case": "upper",
    "letter_spacing_px": 0,
    "line_height": 1.15
  },
  "colors": {
    "primary": "#FFFFFF",
    "active": "#FFE600",
    "outline": "#000000",
    "shadow": "#00000099",
    "box": null
  },
  "stroke": {
    "outline_px": 6,
    "shadow_px": 3,
    "shadow_offset": [
      2,
      3
    ]
  },
  "box": {
    "enabled": false,
    "padding_px": 16,
    "radius_px": 12,
    "opacity": 0.85
  },
  "layout": {
    "anchor": "bottom_center",
    "y_percent": 68,
    "align": "center",
    "max_words_per_line": 3,
    "max_lines": 2,
    "max_chars": {
      "latn": 22,
      "deva": 18,
      "beng": 18
    },
    "safe_area_profile": "shorts_default"
  },
  "animation": {
    "mode": "pages",
    "active_word": "highlight",
    "in": "pop",
    "out": "none",
    "duration_ms": 160,
    "easing": "ease_out"
  },
  "emphasis": {
    "keywords_bold": true,
    "keyword_color": "#00E5FF",
    "numbers_color": null
  },
  "emoji": {
    "enabled": false
  },
  "speaker_colors": {
    "enabled": false,
    "palette": []
  }
}