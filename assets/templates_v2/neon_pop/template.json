{
  "schema_version": 2,
  "kind": "caption",
  "scripts": ["latn", "deva", "beng"],
  "meta": {
    "id": "neon_pop",
    "name": "Neon Pop - Cyan & Magenta",
    "version": 1,
    "author": "starter",
    "license": "Template: MIT. Fonts: SIL OFL 1.1",
    "tags": ["neon", "pop", "gaming", "tech"]
  },
  "aspects": ["9:16", "1:1", "4:5"],
  "fonts": {
    "latn": {
      "family": "Bebas Neue",
      "weight": 700,
      "fallback": ["Noto Sans", "DejaVu Sans", "Sans"]
    },
    "deva": {
      "family": "Mukta",
      "weight": 800,
      "fallback": ["Noto Sans Devanagari", "DejaVu Sans", "Sans"]
    },
    "beng": {
      "family": "Hind Siliguri",
      "weight": 700,
      "fallback": ["Noto Sans Bengali", "DejaVu Sans", "Sans"]
    }
  },
  "text": {
    "size_px": 84,
    "case": "upper",
    "letter_spacing_px": 1,
    "line_height": 1.15
  },
  "colors": {
    "primary": "#FFFFFF",
    "active": "#FF2BD6",
    "outline": "#020617",
    "shadow": "#00E5FFCC",
    "box": null
  },
  "stroke": {
    "outline_px": 5,
    "shadow_px": 6,
    "shadow_offset": [0, 0],
    "glow": {
      "enabled": true,
      "color": "#00E5FF",
      "radius_px": 14
    }
  },
  "box": {
    "enabled": false,
    "padding_px": 16,
    "radius_px": 12,
    "opacity": 0.85
  },
  "layout": {
    "anchor": "bottom_center",
    "y_percent": 66,
    "align": "center",
    "max_words_per_line": 3,
    "max_lines": 2,
    "max_chars": {
      "latn": 20,
      "deva": 16,
      "beng": 16
    },
    "safe_area_profile": "shorts_default"
  },
  "animation": {
    "mode": "pages",
    "active_word": "highlight",
    "in": "pop",
    "out": "none",
    "duration_ms": 140,
    "easing": "ease_out"
  },
  "emphasis": {
    "keywords_bold": true,
    "keyword_color": "#00E5FF",
    "numbers_color": "#FF2BD6"
  },
  "emoji": {
    "enabled": false
  },
  "speaker_colors": {
    "enabled": false,
    "palette": []
  }
}
