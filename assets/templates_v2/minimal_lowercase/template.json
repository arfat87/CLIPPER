{
  "schema_version": 2,
  "meta": {
    "id": "minimal_lowercase",
    "name": "Minimal Lowercase",
    "version": 1,
    "author": "starter",
    "license": "Template: MIT. Fonts: SIL OFL 1.1 (verify files at install)",
    "tags": [
      "minimal",
      "calm"
    ]
  },
  "aspects": [
    "9:16",
    "1:1",
    "4:5"
  ],
  "fonts": {
    "latn": {
      "family": "Poppins",
      "weight": 700,
      "fallback": [
        "Noto Sans"
      ]
    },
    "deva": {
      "family": "Noto Sans Devanagari",
      "weight": 700,
      "fallback": [
        "Mukta"
      ]
    },
    "beng": {
      "family": "Noto Sans Bengali",
      "weight": 700,
      "fallback": [
        "Hind Siliguri"
      ]
    }
  },
  "text": {
    "size_px": 60,
    "case": "lower",
    "letter_spacing_px": 0,
    "line_height": 1.15
  },
  "colors": {
    "primary": "#F5F5F5",
    "active": "#FFFFFF",
    "outline": "#000000",
    "shadow": "#00000099",
    "box": null
  },
  "stroke": {
    "outline_px": 2,
    "shadow_px": 4,
    "shadow_offset": [
      0,
      3
    ]
  },
  "box": {
    "enabled": false,
    "padding_px": 16,
    "radius_px": 12,
    "opacity": 0.85
  },
  "layout": {
    "anchor": "bottom_center",
    "y_percent": 70,
    "align": "center",
    "max_words_per_line": 2,
    "max_lines": 1,
    "max_chars": {
      "latn": 18,
      "deva": 14,
      "beng": 14
    },
    "safe_area_profile": "shorts_default"
  },
  "animation": {
    "mode": "word_by_word",
    "active_word": "none",
    "in": "fade",
    "out": "none",
    "duration_ms": 100,
    "easing": "ease_out"
  },
  "emphasis": {
    "keywords_bold": false,
    "keyword_color": null,
    "numbers_color": null
  },
  "emoji": {
    "enabled": false
  },
  "speaker_colors": {
    "enabled": false,
    "palette": []
  }
}