# syntax=docker/dockerfile:1.7
# ==============================================================================
# Stage 1: Node 22 Frontend Build
# ==============================================================================
FROM node:22-alpine AS frontend-builder

WORKDIR /build/frontend
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY frontend/package.json frontend/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install

COPY frontend/ ./
RUN pnpm run build

# ==============================================================================
# Stage 2: Python 3.11 Slim Runtime with FFmpeg + libass + Noto Fonts (CPU)
# ==============================================================================
FROM python:3.11-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_ENV=prod \
    CLIPPER_DEVICE=cpu \
    ASR_DEVICE=cpu \
    DATA_DIR=/app/data \
    SECRETS_DIR=/app/secrets

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libass9 \
        fontconfig \
        fonts-noto-core \
        fonts-noto-cjk \
        fonts-noto-unhinted \
        curl \
        ca-certificates \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 clipper \
    && useradd --uid 10001 --gid clipper --create-home --shell /bin/bash clipper

WORKDIR /app

COPY pyproject.toml README.md* ./
COPY backend/ ./backend/
COPY hitl/ ./hitl/
COPY drive/ ./drive/
COPY scripts/ ./scripts/
COPY config/ ./config/
COPY contracts/ ./contracts/
COPY assets/ ./assets/
COPY --from=frontend-builder /build/frontend/dist ./frontend/dist

RUN pip install --upgrade pip \
    && pip install . \
    && mkdir -p /app/data /app/secrets /app/.clipper-state /app/drive_mirror \
    && fc-cache -fv /app/assets/fonts || true \
    && chown -R clipper:clipper /app

USER clipper

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/v1/health || exit 1

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
