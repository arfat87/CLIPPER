# syntax=docker/dockerfile:1.7
# ==============================================================================
# Stage 1: Node 22 Frontend Build
# ==============================================================================
FROM node:22-alpine AS frontend-builder

WORKDIR /build/frontend
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY frontend/package.json frontend/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install

COPY frontend/ ./
RUN pnpm run build

# ==============================================================================
# Stage 2: NVIDIA CUDA 12.x Runtime with FFmpeg + libass + Noto Fonts (latn/deva/beng)
# ==============================================================================
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_ENV=prod \
    CLIPPER_DEVICE=cuda \
    ASR_DEVICE=cuda \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,video,utility \
    DATA_DIR=/app/data \
    SECRETS_DIR=/app/secrets

# Install Python 3.11, FFmpeg + libass9, fontconfig, and Noto fonts covering Latin (latn), Devanagari (deva), and Bengali (beng)
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        ca-certificates \
        curl \
        gnupg \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-venv \
        python3.11-distutils \
        python3-pip \
        ffmpeg \
        libass9 \
        fontconfig \
        fonts-noto-core \
        fonts-noto-cjk \
        fonts-noto-unhinted \
        fonts-noto-ui-core \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && python3.11 -m pip install --upgrade pip \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 clipper \
    && useradd --uid 10001 --gid clipper --create-home --shell /bin/bash clipper

WORKDIR /app

COPY pyproject.toml README.md* ./
COPY backend/ ./backend/
COPY hitl/ ./hitl/
COPY drive/ ./drive/
COPY scripts/ ./scripts/
COPY config/ ./config/
COPY contracts/ ./contracts/
COPY assets/ ./assets/
COPY --from=frontend-builder /build/frontend/dist ./frontend/dist

RUN python3.11 -m pip install ".[asr]" \
    && mkdir -p /app/data /app/secrets /app/.clipper-state /app/drive_mirror \
    && fc-cache -fv /app/assets/fonts || true \
    && chown -R clipper:clipper /app

USER clipper

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/v1/health || exit 1

CMD ["python3.11", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
