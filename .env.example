# CLIPPER Environment Configuration
# Copy to .env and fill in values when prompted by HITL blockers.

# --- Core App ---
APP_ENV=local
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
ASSETS_DIR=./assets
CONFIG_DIR=./config
SECRETS_DIR=./secrets
DATABASE_URL=sqlite:///./data/clipper.db

# --- Queue ---
QUEUE_MODE=immediate  # immediate | huey_sqlite | huey_redis
REDIS_URL=redis://localhost:6379/0

# --- ASR (Transcription) ---
ASR_ENGINE=auto       # auto | faster_whisper | heuristic_fallback
ASR_MODEL_SIZE=small  # tiny | base | small | medium | large-v3
ASR_DEVICE=auto       # auto | cpu | cuda
ASR_COMPUTE_TYPE=int8

# --- Highlight Detection (LLM + Signal Fusion) ---
LLM_PROVIDER=auto     # auto | gemini | ollama | heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Human-in-the-Loop (Email Notification Protocol) ---
OWNER_EMAIL=
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_APP_PASSWORD=
NOTIFY_IMAP_HOST=imap.gmail.com
NOTIFY_IMAP_PORT=993
HITL_FALLBACK_TO_FILE=true

# --- Social Platform Cookies (Optional until IG/FB login wall) ---
COOKIES_YOUTUBE=
COOKIES_INSTAGRAM=
COOKIES_FACEBOOK=
